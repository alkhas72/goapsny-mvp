#!/usr/bin/env bash
# Mock curl для Storage API Supabase. MOCK_CURL_FAIL=1 — все запросы падают.
# Отвечает по последнему аргументу-URL; тело POST (-d) читает для list.
url=""
out=""
body=""
write_code=""
prev=""
for a in "$@"; do
  case "$prev" in
    -o) out="$a";;
    -d) body="$a";;
    -w) write_code="$a";;
  esac
  case "$a" in http*) url="$a";;
  esac
  prev="$a"
done

if [ "${MOCK_CURL_FAIL:-0}" = "1" ]; then
  [ -n "$out" ] && : > "$out"
  [ -n "$write_code" ] && printf '500'
  exit 22
fi

respond() { # respond <content> — пишет в -o или stdout
  if [ -n "$out" ]; then printf '%s' "$1" > "$out"; else printf '%s' "$1"; fi
  [ -n "$write_code" ] && printf '200'
  exit 0
}

case "$url" in
  */storage/v1/bucket)
    respond '[{"id":"place-photos","name":"place-photos","public":true}]'
    ;;
  */storage/v1/object/list/*)
    case "$body" in
      *'"prefix":""'*|*'"prefix": ""'*)
        respond '[{"name":"093caee2-5912-4040-811f-f41366d06c10","id":null},{"name":"README.txt","id":"obj-1"}]'
        ;;
      *)
        respond '[{"name":"facade.jpg","id":"obj-2"}]'
        ;;
    esac
    ;;
  */storage/v1/object/*)
    respond 'FAKE-IMAGE-BYTES'
    ;;
  */rest/v1/*)
    respond '[]'
    ;;
  *)
    echo "mock curl: неизвестный URL $url" >&2
    [ -n "$write_code" ] && printf '404'
    exit 22
    ;;
esac
